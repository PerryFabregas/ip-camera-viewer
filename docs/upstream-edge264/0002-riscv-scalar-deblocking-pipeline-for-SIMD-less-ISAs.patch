+	uint8_t *r = q0p;
+	for (int k = 0; k < 8; k++, r += de) {
+		int p0 = r[-dc], q0 = r[0];
+		int d = p0 - q0;
+		if ((d < 0 ? -d : d) >= alpha)
+			continue;
+		int p1 = r[-dc * 2], q1 = r[dc];
+		d = p1 - p0;
+		if ((d < 0 ? -d : d) >= beta)
+			continue;
+		d = q1 - q0;
+		if ((d < 0 ? -d : d) >= beta)
+			continue;
+		r[-dc] = (2 * p1 + p0 + q1 + 2) >> 2;
+		r[0] = (2 * q1 + q0 + p1 + 2) >> 2;
